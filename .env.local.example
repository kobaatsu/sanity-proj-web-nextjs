NEXT_PUBLIC_SANITY_PROJECT_ID=a3qfw1bg
NEXT_PUBLIC_SANITY_DATASET=production

# Viewer権限のAPIトークン（manage.sanity.ioで発行）。Presentation Toolでのドラフト取得に使用
SANITY_API_READ_TOKEN=

# Studioの公開URL（例: https://sanity-proj.sanity.studio）。stegaリンクの遷移先に使用
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# TypeSafe (https://typesafe.ai/) で発行した API Key を設定してください
# Studioのお知らせ入稿時のカテゴリー提案機能で使用します（CORS回避のためのサーバー経由プロキシ）
TYPESAFE_API_KEY=

# /api/typesafe/suggest-news-category への任意アクセスを防ぐ共有シークレット
# studio側の .env.local の SANITY_STUDIO_INTERNAL_API_SECRET と同じ値を設定してください
# 未設定の場合はチェックがスキップされるため、必ず設定することを推奨します
INTERNAL_API_SECRET=
